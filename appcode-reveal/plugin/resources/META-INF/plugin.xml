  <vendor>JetBrains</vendor>

  <dependencies>
    <plugin id="com.intellij.modules.appcode"/>
  </dependencies>

  <content namespace="jetbrains">
    <module name="intellij.appcode.reveal"/>
  </content>

</idea-plugin>

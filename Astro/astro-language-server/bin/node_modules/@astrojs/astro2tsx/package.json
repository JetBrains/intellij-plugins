{
  "name": "@astrojs/astro2tsx",
  "version": "0.1.2",
  "description": "Convert .astro files to TSX for TypeScript editor tooling",
  "keywords": [
    "astro",
    "tsx",
    "intellisense",
    "language-server",
    "content-mapper"
  ],
  "homepage": "https://astro.build",
  "bugs": "https://github.com/withastro/compiler-rs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withastro/compiler-rs.git",
    "directory": "crates/astro2tsx"
  },
  "license": "MIT",
  "author": "Astro contributors",
  "type": "module",
  "main": "index.js",
  "files": [
    "astro2tsx.wasm32-wasi.wasm",
    "index.d.ts",
    "index.js"
  ],
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@napi-rs/wasm-runtime": "1.2.4"
  },
  "devDependencies": {
    "@emnapi/runtime": "1.11.3",
    "@napi-rs/cli": "3.7.4",
    "@types/node": "^22",
    "emnapi": "1.11.3",
    "typescript": "~5.5.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "binaryName": "astro2tsx",
    "packageName": "@astrojs/astro2tsx",
    "constEnum": false,
    "runtimeStringEnum": true
  },
  "scripts": {
    "build": "napi build --platform --no-js --target wasm32-wasip1-threads --release",
    "build-dev": "napi build --platform --no-js --target wasm32-wasip1-threads",
    "test": "node --test ./__test__/*.test.ts",
    "version": "napi version"
  }
}
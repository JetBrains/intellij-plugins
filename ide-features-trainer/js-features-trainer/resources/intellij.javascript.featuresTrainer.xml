<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.javascript.psi.impl"/>
    <plugin id="training"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.debugger"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.smRunner"/>
    <module name="intellij.platform.testRunner"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="training">
    <!--<ift.language.extension language="JavaScript" defaultProductName="WebStorm"-->
    <!--                        implementationClass="com.intellij.javascript.ift.JavaScriptLangSupport"/>-->
    <!--<ift.learning.course language="JavaScript" implementationClass="com.intellij.javascript.ift.JavaScriptMainLearningCourse"/>-->
    <!--<ifs.suggesterSupport language="JavaScript" implementationClass="com.intellij.javascript.ifs.JavaScriptSuggesterSupport"/>-->
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <registryKey key="ift.show.feedback.link.javascript"
                 description="Whether IFT show feedback link in the modules panel for JavaScript course."
                 defaultValue="TRUE"
                 restartRequired="false"/>
    <lang.documentationProvider language="JavaScript" implementationClass="com.intellij.javascript.ift.JavaScriptOnboardingTipsDocumentationProvider" order="first"/>
  </extensions>

<idea-plugin package="com.intellij.clion.diagnostics.cmake">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.cpp-diagnostics"/>
    <module name="intellij.cidr.util.execution"/>
    <module name="intellij.cidr.workspaceModel"/>
    <module name="intellij.clion.toolchains"/>
    <module name="intellij.cmake.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.projectModel"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij.clion.diagnostics">
    <workspaceDescriptionProvider implementation="com.intellij.clion.diagnostics.cmake.workspace.CMakeWorkspaceDescriptionProvider"/>
  </extensions>
</idea-plugin>
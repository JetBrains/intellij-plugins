/dts-v1/;
#include "imx6q.dtsi"
#include "imx6qdl-emcon.dtsi"
#include "imx6qdl-emcon-avari.dtsi"

/ {
	model = "emtrion SoM emCON-MX6 Dual/Quad on Avari";
	compatible = "emtrion,emcon-mx6-avari", "fsl,imx6q";
};

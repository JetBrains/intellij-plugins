/dts-v1/;

#include "imx6q-display5.dtsi"

&panel {
	compatible = "tianma,tm070jdhg30";
};

&ldb {
	lvds0: lvds-channel@0 {
		fsl,data-mapping = "spwg";
		fsl,data-width = <18>;
	};
};
// SPDX-License-Identifier: GPL-2.0

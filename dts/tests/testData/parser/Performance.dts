/dts-v1/;

#include "aspeed-g5.dtsi"

/ {
	model = "S2600WF BMC";
	compatible = "intel,s2600wf-bmc", "aspeed,ast2500";

	chosen {
		stdout-path = &uart5;
		bootargs = "earlyprintk";
	};


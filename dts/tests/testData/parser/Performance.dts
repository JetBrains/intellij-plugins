/dts-v1/;

#include "imx6q.dtsi"
#include "imx6qdl-pico-pi.dtsi"

/ {
	model = "TechNexion PICO-IMX6 Quad Board and Dwarf baseboard";
	compatible = "technexion,imx6q-pico", "fsl,imx6q";
};

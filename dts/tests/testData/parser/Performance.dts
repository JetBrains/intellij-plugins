			max-cur = /bits/ 8 <15>;
		};
		chan6 {
			led-cur = /bits/ 8 <12>;
			max-cur = /bits/ 8 <15>;
		};
		chan7 {
			led-cur = /bits/ 8 <12>;
			max-cur = /bits/ 8 <15>;
		};
		chan8 {
			led-cur = /bits/ 8 <12>;
			max-cur = /bits/ 8 <15>;
		};
	};

	lp5523C: lp5523C@34 {
		compatible = "national,lp5523";
		label = "q4";
		reg = <0x34>;
		clock-mode = /bits/ 8 <0>; /* LP55XX_CLOCK_AUTO */

		chan0 {
			led-cur = /bits/ 8 <12>;
			max-cur = /bits/ 8 <15>;
		};
		chan1 {
			led-cur = /bits/ 8 <12>;

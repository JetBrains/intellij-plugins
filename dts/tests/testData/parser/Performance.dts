#include "imx6q.dtsi"
#include "imx6qdl-savageboard.dtsi"

/ {
	model = "Poslab SavageBoard Quad";
	compatible = "poslab,imx6q-savageboard", "fsl,imx6q";
};

&sata {
	status = "okay";

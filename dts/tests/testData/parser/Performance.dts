/dts-v1/;

/include/ "amd-seattle-soc.dtsi"

/ {
	model = "AMD Seattle (Rev.B0) Development Board (Overdrive)";
	compatible = "amd,seattle-overdrive", "amd,seattle";

	chosen {
		stdout-path = &serial0;
	}

	/include/ "amd-seattle-soc.dtsi"

	psci {
		compatible   = "arm,psci-0.2";
		method       = "smc";
	};
};

&ccp0 {
	status = "ok";
	amd,zlib-support = <1>;
};

/**
 * NOTE: In Rev.B, gpio0 is reserved.
 */

/ {
	model = "Spreadtrum SP9860G 3GFHD Board";

	compatible = "sprd,sp9860g-1h10", "sprd,sc9860";

	aliases {
		serial0 = &uart0; /* for Bluetooth */
		serial1 = &uart1; /* UART console */

/dts-v1/;
#include "exynos4412-galaxy-s3.dtsi"

/ {
	model = "Samsung Galaxy S3 (GT-I9300) based on Exynos4412";
	compatible = "samsung,i9300", "samsung,midas", "samsung,exynos4412", "samsung,exynos4";

	/* bootargs are passed in by bootloader */

	memory@40000000 {

#include "imx6qdl-sr-som-ti.dtsi"
#include "imx6qdl-cubox-i.dtsi"

/ {
	model = "SolidRun Cubox-i Solo/DualLite (1.5som)";
	compatible = "solidrun,cubox-i/dl", "fsl,imx6dl";

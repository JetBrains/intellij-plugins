	gpio_keys {
		compatible = "gpio-keys";
		#address-cells = <1>;
		#size-cells = <0>;

		irqbtn@18 {
			reg = <18>;
			label = "IRQBTN";
			linux,code = <99>;
			gpios = <&pioB 18 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};
};

&watchdog {
	status = "okay";

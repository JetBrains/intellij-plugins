/dts-v1/;
#include "sun7i-a20-olimex-som204-evb.dts"

/ {
	model = "Olimex A20-SOM204-EVB-eMMC";
	compatible = "olimex,a20-olimex-som204-evb-emmc", "allwinner,sun7i-a20";

	mmc2_pwrseq: mmc2_pwrseq {
		compatible = "mmc-pwrseq-emmc";

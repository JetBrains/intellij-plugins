	lp5523B: lp5523B@33 {
		compatible = "national,lp5523";
		label = "q3";
		reg = <0x33>;
		clock-mode = /bits/ 8 <0>; /* LP55XX_CLOCK_AUTO */

		chan0 {
			led-cur = /bits/ 8 <12>;
			max-cur = /bits/ 8 <15>;
		};
		chan1 {
			led-cur = /bits/ 8 <12>;
			max-cur = /bits/ 8 <15>;
		};
		chan2 {
			led-cur = /bits/ 8 <12>;
			max-cur = /bits/ 8 <15>;
		};

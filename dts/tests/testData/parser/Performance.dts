				gpios = <&gpioi 5 0>;
				default-state = "off";
			};
			led6 {
				label = "LED6";
				gpios = <&gpioi 6 0>;
				default-state = "off";
			};
			led7 {
				label = "LED7";
				gpios = <&gpioi 7 0>;

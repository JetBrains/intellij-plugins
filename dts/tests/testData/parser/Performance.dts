#include "qcom-ipq4019-ap.dk04.1.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ4019/AP-DK04.1-C1";
	compatible = "qcom,ipq4019-dk04.1-c1";

	soc {
		dma@7984000 {
			status = "ok";
		};

		qpic-nand@79b0000 {
			status = "ok";
		};
	};
};

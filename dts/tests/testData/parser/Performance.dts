/dts-v1/;
#include "imx7s-colibri.dtsi"
#include "imx7-colibri-aster.dtsi"

/ {
	model = "Toradex Colibri iMX7S on Aster Carrier Board";
	compatible = "toradex,colibri-imx7s-aster", "toradex,colibri-imx7s",
		     "fsl,imx7s";
};

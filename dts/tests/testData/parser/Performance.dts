			MX8MQ_IOMUXC_SD1_DATA3_USDHC1_DATA3		0xdf
			MX8MQ_IOMUXC_GPIO1_IO00_ANAMIX_REF_CLK_32K	0x85
		>;
	};

	pinctrl_usdhc2_gpio: usdhc2gpiogrp {

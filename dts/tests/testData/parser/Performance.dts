/dts-v1/;

#include "bcm958742-base.dtsi"

/ {
	compatible = "brcm,bcm958742t", "brcm,stingray";
	model = "Stingray SST100 (BCM958742T)";
};

&gphy0 {
	enet-phy-lane-swap;
};

&sdio0 {
	mmc-ddr-1_8v;
};

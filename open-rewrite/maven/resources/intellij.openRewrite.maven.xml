<idea-plugin package="com.intellij.openRewrite.maven">
  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.maven"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <!-- endregion -->
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <openRewrite.externalSystemBridge implementation="com.intellij.openRewrite.maven.OpenRewriteMavenBridge"
                                      order="last"/>
    <openRewrite.libraryResolver implementation="com.intellij.openRewrite.maven.OpenRewriteMavenLibraryResolver"/>
  </extensions>
</idea-plugin>

<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="org.intellij.plugins.markdown"/>
    <module name="intellij.markdown"/>
    <module name="intellij.markdown.frontend"/>
    <module name="intellij.mdx.shared"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ex"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.kernel"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
  </dependencies>
  <!-- endregion -->

  <projectListeners>
    <listener class="com.intellij.mdx.frontend.editor.MdxCodeFenceCompletionIndentRestorer"
              topic="com.intellij.codeInsight.lookup.LookupManagerListener"/>
  </projectListeners>
  <extensions defaultExtensionNs="com.intellij">
    <editorActionHandler action="EditorPaste"
                         implementationClass="com.intellij.mdx.frontend.editor.MdxCodeFencePasteHandler"
                         order="first"/>
  </extensions>

  <extensions defaultExtensionNs="org.intellij.markdown">
    <actionPromoterExtension implementation="com.intellij.mdx.frontend.markdown.MdxFrontendMarkdownActionPromoterExtension"/>
  </extensions>
</idea-plugin>

<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="org.intellij.qodana"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.mcpserver"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.inspect"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.qodana.inspectionKts"/>
    <module name="intellij.qodana.sarif"/>
    <module name="intellij.qodana.util"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="org.intellij.qodana">
    <qodanaScriptFactory implementation="org.jetbrains.qodana.inspectionKts.mcp.McpServerScriptFactory"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij.mcpServer">
    <mcpToolset implementation="org.jetbrains.qodana.inspectionKts.mcp.InspectionKtsMcpToolset"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <dynamicInspectionsProvider implementation="org.jetbrains.qodana.inspectionKts.mcp.impl.ExtractedInspectionsDynamicProvider"/>
  </extensions>
</idea-plugin>

<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="org.jetbrains.plugins.go"/>
    <module name="intellij.go.coverage"/>
    <module name="intellij.platform.collaborationTools"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.qodana.coverage"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="org.intellij.qodana">
    <reportMetadataArtifact implementation="org.jetbrains.qodana.go.GoCoverageReportMetadataArtifact"/>
    <reportMetadataArtifact implementation="org.jetbrains.qodana.go.GoCoverageProjectDataReportMetadataArtifact"/>
    <workflowExtension implementation="org.jetbrains.qodana.go.QodanaValidateGoSdk"/>
    <workflowExtension implementation="org.jetbrains.qodana.go.QodanaRestoreGoSdk"/>
    <psiStructuralFingerprintsProvider language="go" implementationClass="org.jetbrains.qodana.go.psi.GoPsiStructuralFingerprintsProvider"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <qodana.coverage.cloudArtifactsProcessor implementation="org.jetbrains.qodana.go.GoCoverageArtifactProcessor"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <globalInspection hasStaticDescription="true"
                      language="go"
                      shortName="GoCoverageInspection"
                      key="check.go.display.name"
                      bundle="messages.QodanaBundle"
                      groupKey="coverage.group.display.name"
                      enabledByDefault="true"
                      implementationClass="org.jetbrains.qodana.go.GoCoverageInspection"/>
  </extensions>
</idea-plugin>

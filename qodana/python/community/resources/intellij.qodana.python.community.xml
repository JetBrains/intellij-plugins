<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.modules.python"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.backend.observation"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.sdk.backend"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="org.intellij.qodana">
    <psiStructuralFingerprintsProvider language="Python" implementationClass="org.jetbrains.qodana.python.community.psi.PythonPsiStructuralFingerprintsProvider"/>
    <workflowExtension implementation="org.jetbrains.qodana.python.community.QodanaConfigurePythonProjectSdk"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="org.jetbrains.qodana.python.community.QodanaPycharmPythonPathActivity"/>
  </extensions>
</idea-plugin>

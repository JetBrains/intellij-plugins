<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="org.intellij.qodana"/>
    <module name="intellij.json.backend"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.lang"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="SARIF" extensions="sarif" patterns="*.sarif.json;*.sarif*.json"
              implementationClass="org.jetbrains.qodana.json.SarifFileType" fieldName="INSTANCE" language="JSON"/>
    <applicationService serviceInterface="org.jetbrains.qodana.filetype.QodanaSarifFileMatcher"
                        serviceImplementation="org.jetbrains.qodana.json.QodanaSarifFileMatcherImpl"/>
  </extensions>
</idea-plugin>

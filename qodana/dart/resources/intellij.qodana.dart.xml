<idea-plugin>
  <dependencies>
    <plugin id="com.intellij.modules.ultimate"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <plugin id="org.intellij.qodana"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.eel.provider"/>
    <module name="intellij.platform.inspect"/>
    <module name="intellij.platform.lang.impl"/>
    <!-- endregion -->
  </dependencies>
  <resource-bundle>messages.QodanaDartBundle</resource-bundle>
  <extensions defaultExtensionNs="org.intellij.qodana">
    <externalToolsProvider implementation="org.jetbrains.qodana.dart.DartAnalyzeInspectionDescriptorProvider"/>
    <globalOutputConsumer implementation="org.jetbrains.qodana.dart.DartAnalyzeGlobalInspectionOutputConsumer"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <codeInspection.InspectionExtension implementation="org.jetbrains.qodana.dart.DartAnalyzeGlobalInspectionContextFactory"/>
    <globalInspection language=""
                      hasStaticDescription="true"
                      key="inspection.dart.analyze.name"
                      bundle="messages.QodanaDartBundle"
                      shortName="DartAnalyzeGlobalInspection"
                      groupKey="inspection.dart.analyze.group.name"
                      groupBundle="messages.QodanaDartBundle"
                      enabledByDefault="true"
                      level="WARNING"
                      presentation="org.jetbrains.qodana.dart.DartAnalyzeGlobalInspectionPresentation"
                      implementationClass="org.jetbrains.qodana.dart.DartAnalyzeGlobalInspection"/>
  </extensions>
</idea-plugin>

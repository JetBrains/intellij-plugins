<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.modules.qodana.ijVoid"/>
    <plugin id="com.intellij.modules.ultimate"/>
    <plugin id="org.intellij.qodana"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.analysis.impl"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.eel.provider"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.inspect"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.qodana.sarif"/>
  </dependencies>
  <!-- endregion -->
  <resource-bundle>messages.QodanaDartBundle</resource-bundle>
  <extensions defaultExtensionNs="org.intellij.qodana">
    <globalOutputConsumer implementation="org.jetbrains.qodana.dart.DartAnalyzeGlobalOutputConsumer"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <globalInspection language=""
                      hasStaticDescription="true"
                      key="inspection.dart.analyze.name"
                      bundle="messages.QodanaDartBundle"
                      shortName="DartAnalyze"
                      groupKey="inspection.dart.analyze.taxonomy.name"
                      groupPathKey="inspection.dart.analyze.group.name"
                      groupBundle="messages.QodanaDartBundle"
                      enabledByDefault="true"
                      level="WARNING"
                      implementationClass="org.jetbrains.qodana.dart.DartAnalyzeGlobalInspection"/>
    <globalInspection language=""
                      hasStaticDescription="true"
                      key="inspection.dart.sanity.name"
                      bundle="messages.QodanaDartBundle"
                      shortName="DartAnalyzeSanity"
                      groupKey="inspection.dart.analyze.taxonomy.name"
                      groupPathKey="inspection.dart.analyze.group.name"
                      groupBundle="messages.QodanaDartBundle"
                      enabledByDefault="false"
                      level="ERROR"
                      implementationClass="org.jetbrains.qodana.dart.DartAnalyzeSanityInspection"/>
  </extensions>
</idea-plugin>

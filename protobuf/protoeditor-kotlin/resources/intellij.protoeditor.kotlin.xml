<idea-plugin package="com.intellij.protobuf.kotlin">
    <dependencies>
        <plugin id="org.jetbrains.kotlin"/>
        <module name="intellij.java.backend"/>
        <module name="intellij.protoeditor.jvm"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <protobuf.codeImplementationSearcher implementation="com.intellij.protobuf.kotlin.PbKotlinImplementationSearcher"/>
        <!-- Kotlin -> proto goto -->
        <gotoDeclarationHandler
                implementation="com.intellij.protobuf.kotlin.PbKotlinGotoDeclarationHandler"/>
        <!-- proto -> Kotlin/Java find usages -->
        <findUsagesHandlerFactory
                implementation="com.intellij.protobuf.kotlin.PbKotlinFindUsagesHandlerFactory"
                order="first"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="com.intellij.protobuf.kotlin.PbKotlinLineMarkerProvider"/>
    </extensions>
</idea-plugin>

<!-- BUILD_USING_BAZEL_MARKER: this plugin is also packaged by the `ij_plugin` Bazel rule, and IjPluginDistributionEquivalenceTest
     checks that the result matches the distribution produced by the build scripts. See MRI-4743. -->
<idea-plugin allow-bundled-update="true">
  <name>Protocol Buffers</name>
  <id>idea.plugin.protoeditor</id>
  <vendor>JetBrains</vendor>
  <category>Languages</category>
  <description><![CDATA[
    Provides editor support for <a href="https://developers.google.com/protocol-buffers/">Protocol Buffers</a> files.
    <br>
    Features:
    <ul>
        <li>Support for <code>proto2</code> and <code>proto3</code> syntax levels.</li>
        <li>Syntax highlighting.</li>
        <li>Semantic analysis.</li>
        <li>References and navigation.</li>
        <li>Quick documentation.</li>
        <li>Editor enhancements (completion, brace matching, etc.).</li>
        <li>Navigating between protobuf files and some other languages (Java, Go, Python).</li>
    </ul>
  ]]></description>

  <content namespace="jetbrains">
    <module name="intellij.protoeditor.core" loading="required"/>
    <module name="intellij.protoeditor.go"/>
    <module name="intellij.protoeditor.python"/>
    <module name="intellij.protoeditor.jvm"/>
  </content>

  <dependencies>
    <plugin id="com.intellij.modules.lang"/>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.libraries.protobuf.java.util"/>
    <module name="intellij.platform.structureView"/>
    <!-- endregion -->
  </dependencies>

  <extensions defaultExtensionNs="com.intellij">
    <dependencySupport coordinate="com.google.protobuf:protobuf-java" kind="java" displayName="Protocol Buffers"/>
    <dependencySupport coordinate="com.google.protobuf:protobuf-java-util" kind="java" displayName="Protocol Buffers"/>
    <dependencySupport coordinate="com.google.protobuf:protobuf-kotlin" kind="java" displayName="Protocol Buffers"/>
    <dependencySupport coordinate="com.google.protobuf:protobuf-javalite" kind="java" displayName="Protocol Buffers"/>
    <dependencySupport coordinate="io.grpc:grpc-protobuf" kind="java" displayName="gRPC Protobuf"/>
    <dependencySupport coordinate="io.grpc:grpc-protobuf-lite" kind="java" displayName="gRPC Protobuf"/>
  </extensions>
</idea-plugin>
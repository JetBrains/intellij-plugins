<idea-plugin package="com.intellij.protobuf.jvm">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.java.backend"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <protobuf.codeImplementationSearcher implementation="com.intellij.protobuf.jvm.gutter.PbJavaImplementationSearcher"/>
    <!-- Java -> proto goto -->
    <gotoDeclarationHandler
      implementation="com.intellij.protobuf.jvm.PbJavaGotoDeclarationHandler"/>
    <fileBasedIndex
      implementation="com.intellij.protobuf.jvm.PbJavaOuterClassIndex"/>
    <!-- proto -> java find usages -->
    <findUsagesHandlerFactory
      implementation="com.intellij.protobuf.jvm.PbJavaFindUsagesHandlerFactory"/>
    <codeInsight.lineMarkerProvider language="JAVA"
                                    implementationClass="com.intellij.protobuf.jvm.gutter.PbJavaLineMarkerProvider"/>
  </extensions>
</idea-plugin>

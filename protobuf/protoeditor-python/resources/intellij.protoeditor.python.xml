<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.stream"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.markdown.utils"/>
    <module name="intellij.platform.usageView"/>
    <module name="intellij.platform.util.ui"/>
    <module name="intellij.python.psi.impl"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="Pythonid">
    <typeProvider implementation="com.intellij.protobuf.python.types.PbPythonTypeProvider"/>
    <pyModuleMembersProvider implementation="com.intellij.protobuf.python.types.PbPythonModuleMembersProvider"/>
    <typeCheckerExtension implementation="com.intellij.protobuf.python.types.PbPythonTypeCheckerExtension"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Goto Declaration: only for generated `.py` -> `.proto` -->
    <gotoDeclarationHandler
      implementation="com.intellij.protobuf.python.navigation.PbPythonGotoDeclarationHandler"
      order="first"/>

    <!-- Goto Type Declaration -->
    <typeDeclarationProvider
      implementation="com.intellij.protobuf.python.navigation.PbPythonTypeDeclarationProvider"
      order="first"/>
  </extensions>
</idea-plugin>
